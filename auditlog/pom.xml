<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.debezium.examples</groupId>
    <artifactId>debezium-examples-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <groupId>io.debezium.demos.auditing</groupId>
  <artifactId>auditing-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <!--
      Pin Quarkus to the version Kogito 10.2.0 was built against.
      Kogito does not yet have a release targeting Quarkus 3.33.x; using a
      newer Quarkus causes a NoSuchMethodError in Quarkus bootstrap internals.
    -->
    <version.quarkus>3.27.2</version.quarkus>
  </properties>
  <dependencyManagement>
    <dependencies>
      <!--
        Explicitly import quarkus-bom:3.27.2 here so it takes precedence over
        the quarkus-bom:3.33.x that is transitively pulled in via debezium-server-bom
        in the root parent POM.  A child POM's dependencyManagement entries win
        over those inherited from the parent.
      -->
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modules>
    <module>vegetables-service</module>
    <module>log-enricher</module>
    <module>admin-service</module>
  </modules>
</project>
