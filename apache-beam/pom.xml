<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.debezium.examples</groupId>
        <artifactId>debezium-examples-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.debezium.examples.apache.beam</groupId>
    <artifactId>apache-beam</artifactId>

    <properties>
        <!--
            Snapshot version on purpose: the latest release, 2.77.0, doesn't pass all of
            Debezium's metadata through to the pipeline.
        -->
        <version.beam>2.79.0-SNAPSHOT</version.beam>
        <version.debezium>3.5.2.Final</version.debezium>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Keeps the Google Cloud libraries at the versions Beam is built with.
                The parent imports debezium-server-bom:${version.debezium}, so the 3.5.2.Final pin above
                pulls in com.google.cloud:libraries-bom:26.17.0, which manages older Google Cloud versions.
                Those lack methods the Storage Write API sink needs, so writes fail with NoSuchMethodError.
            -->
            <dependency>
                <groupId>org.apache.beam</groupId>
                <artifactId>beam-sdks-java-google-cloud-platform-bom</artifactId>
                <version>${version.beam}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            Pinned to 3.5.2.Final to match the Debezium version Apache Beam 2.76.0 is built against
            (beam-sdks-java-io-debezium depends on debezium-core 3.5.2.Final).
            See https://repo1.maven.org/maven2/org/apache/beam/beam-sdks-java-io-debezium/2.76.0/beam-sdks-java-io-debezium-2.76.0.pom
        -->
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-connector-mysql</artifactId>
            <version>${version.debezium}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.beam</groupId>
            <artifactId>beam-sdks-java-io-debezium</artifactId>
            <version>${version.beam}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.beam</groupId>
            <artifactId>beam-sdks-java-io-google-cloud-platform</artifactId>
            <version>${version.beam}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.beam</groupId>
            <artifactId>beam-sdks-java-core</artifactId>
            <version>${version.beam}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.beam</groupId>
            <artifactId>beam-runners-google-cloud-dataflow-java</artifactId>
            <version>${version.beam}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.beam</groupId>
            <artifactId>beam-runners-direct-java</artifactId>
            <version>${version.beam}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!-- Beam snapshot builds aren't on Maven Central -->
    <repositories>
        <repository>
            <id>apache.snapshots</id>
            <url>https://repository.apache.org/content/repositories/snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

</project>
