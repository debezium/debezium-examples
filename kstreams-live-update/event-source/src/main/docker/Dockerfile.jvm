####
# Image for the event source, a plain Java application (not Quarkus).
#
# Before building the image, run:
#
# mvn clean package -f event-source/pom.xml
#
# The maven-dependency-plugin copies the application's dependencies next to its jar in target/,
# and run-java.sh puts every jar in /deployments on the class path and starts JAVA_MAIN_CLASS,
# which is set in the Docker Compose files.
###
FROM registry.access.redhat.com/ubi9/openjdk-21:1.21

ENV LANGUAGE='en_US:en'

COPY --chown=185 target/*.jar /deployments/

USER 185
