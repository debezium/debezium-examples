# Multi-stage build so `docker compose build splitter` is self-contained
# (no prior local `mvn package` required).
# The build context is the repository root so that the shared parent POM is available;
# Dockerfile.jvm.dockerignore limits the context to the files this build needs.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY debezium-relational-to-neo4j/splitter/pom.xml debezium-relational-to-neo4j/splitter/
RUN mvn -q -B -f debezium-relational-to-neo4j/splitter/pom.xml dependency:go-offline
COPY debezium-relational-to-neo4j/splitter/src debezium-relational-to-neo4j/splitter/src
RUN mvn -q -B -f debezium-relational-to-neo4j/splitter/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/debezium-relational-to-neo4j/splitter/target/neo4j-cud-splitter.jar /app/neo4j-cud-splitter.jar
ENTRYPOINT ["java", "-jar", "/app/neo4j-cud-splitter.jar"]
