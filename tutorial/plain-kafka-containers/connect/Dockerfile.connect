ARG KAFKA_VERSION=4.3.1
ARG DEBEZIUM_VERSION=3.6.1.Final

FROM apache/kafka:${KAFKA_VERSION}

ARG DEBEZIUM_VERSION

USER root

# Install curl (not present by default in Alpine-based apache/kafka image)
RUN apk add --no-cache curl

# Create plugin directory for Debezium connector JARs
RUN mkdir -p /opt/kafka/plugins

# Download and unpack Debezium PostgreSQL connector
RUN curl -sfSL https://repo1.maven.org/maven2/io/debezium/debezium-connector-postgres/${DEBEZIUM_VERSION}/debezium-connector-postgres-${DEBEZIUM_VERSION}-plugin.tar.gz | \
    tar -xzf - -C /opt/kafka/plugins

# Override the default connect-distributed.properties with our configuration
COPY connect-distributed.properties /opt/kafka/config/connect-distributed.properties

USER appuser

CMD ["/opt/kafka/bin/connect-distributed.sh", "/opt/kafka/config/connect-distributed.properties"]
